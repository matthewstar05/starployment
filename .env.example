# All core discovery, ranking, resume tailoring and form filling work without an LLM.
JOBHUB_LLM_BACKEND=none          # none | auto | anthropic | claude_cli
ANTHROPIC_API_KEY=
# Only set an Anthropic model ID available to your account when opting in.
# JOBHUB_ANTHROPIC_MODEL=
# JOBHUB_CLAUDE_CLI_MODEL=sonnet
JOBHUB_HEADLESS=1                # 0 shows the browser during attempts
JOBHUB_PORT=8765
